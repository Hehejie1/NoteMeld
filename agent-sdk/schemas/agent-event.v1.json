{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notemeld.wiki/schemas/agent-event.v1.json",
  "title": "AgentEventEnvelope v1",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "sequence",
    "session_id",
    "turn_id",
    "timestamp",
    "type",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "event_id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "turn_id": { "type": "string", "format": "uuid" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+]00:00)$"
    },
    "type": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" }
  },
  "oneOf": [
    {
      "properties": {
        "type": { "const": "turn.started" },
        "payload": { "$ref": "#/$defs/turn_started_payload" }
      }
    },
    {
      "properties": {
        "type": { "const": "message.started" },
        "payload": { "$ref": "#/$defs/message_started_payload" }
      }
    },
    {
      "properties": {
        "type": { "const": "message.delta" },
        "payload": { "$ref": "#/$defs/message_delta_payload" }
      }
    },
    {
      "properties": {
        "type": { "const": "message.completed" },
        "payload": { "$ref": "#/$defs/message_completed_payload" }
      }
    },
    {
      "properties": {
        "type": { "const": "tool.started" },
        "payload": { "$ref": "#/$defs/tool_started_payload" }
      }
    },
    {
      "properties": {
        "type": { "const": "tool.progress" },
        "payload": { "$ref": "#/$defs/tool_progress_payload" }
      }
    },
    {
      "properties": {
        "type": { "const": "tool.completed" },
        "payload": { "$ref": "#/$defs/tool_completed_payload" }
      }
    },
    {
      "properties": {
        "type": { "const": "approval.required" },
        "payload": { "$ref": "#/$defs/approval_required_payload" }
      }
    },
    {
      "properties": {
        "type": { "const": "approval.resolved" },
        "payload": { "$ref": "#/$defs/approval_resolved_payload" }
      }
    },
    {
      "properties": {
        "type": { "const": "usage.updated" },
        "payload": { "$ref": "#/$defs/usage_updated_payload" }
      }
    },
    {
      "properties": {
        "type": { "const": "turn.succeeded" },
        "payload": { "$ref": "#/$defs/turn_succeeded_payload" }
      }
    },
    {
      "properties": {
        "type": { "const": "turn.failed" },
        "payload": { "$ref": "#/$defs/turn_failed_payload" }
      }
    },
    {
      "properties": {
        "type": { "const": "turn.cancelled" },
        "payload": { "$ref": "#/$defs/turn_cancelled_payload" }
      }
    },
    {
      "properties": {
        "type": { "const": "turn.interrupted" },
        "payload": { "$ref": "#/$defs/turn_interrupted_payload" }
      }
    },
    {
      "description": "Forward-compatible fallback for unknown v1 event types.",
      "properties": {
        "type": { "not": { "$ref": "#/$defs/approved_v1_event_type" } },
        "payload": { "type": "object" }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "approved_v1_event_type": {
      "enum": [
        "turn.started",
        "message.started",
        "message.delta",
        "message.completed",
        "tool.started",
        "tool.progress",
        "tool.completed",
        "approval.required",
        "approval.resolved",
        "usage.updated",
        "turn.succeeded",
        "turn.failed",
        "turn.cancelled",
        "turn.interrupted"
      ]
    },
    "turn_started_payload": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "created",
            "running",
            "waiting_approval",
            "cancelling",
            "succeeded",
            "failed",
            "cancelled",
            "interrupted"
          ]
        }
      },
      "additionalProperties": true
    },
    "message_started_payload": {
      "type": "object",
      "properties": {
        "message_id": { "type": "string" },
        "role": { "type": "string" }
      },
      "additionalProperties": true
    },
    "message_delta_payload": {
      "type": "object",
      "properties": {
        "message_id": { "type": "string" },
        "delta": { "type": "string" }
      },
      "additionalProperties": true
    },
    "message_completed_payload": {
      "type": "object",
      "properties": {
        "message_id": { "type": "string" },
        "role": { "type": "string" },
        "content": true
      },
      "additionalProperties": true
    },
    "tool_started_payload": {
      "type": "object",
      "properties": {
        "call_id": { "type": "string" },
        "tool_name": { "type": "string" },
        "arguments_summary": true
      },
      "additionalProperties": true
    },
    "tool_progress_payload": {
      "type": "object",
      "properties": {
        "call_id": { "type": "string" },
        "message": { "type": "string" },
        "progress": { "type": "number" }
      },
      "additionalProperties": true
    },
    "tool_completed_payload": {
      "type": "object",
      "properties": {
        "call_id": { "type": "string" },
        "tool_name": { "type": "string" },
        "status": { "type": "string" },
        "result_summary": true
      },
      "additionalProperties": true
    },
    "approval_required_payload": {
      "type": "object",
      "properties": {
        "approval_id": { "type": "string" },
        "call_id": { "type": "string" },
        "action_digest": { "type": "string" },
        "risk": { "type": "string" },
        "summary": { "type": "string" },
        "deadline": { "type": "string" }
      },
      "additionalProperties": true
    },
    "approval_resolved_payload": {
      "type": "object",
      "properties": {
        "approval_id": { "type": "string" },
        "decision": { "type": "string" }
      },
      "additionalProperties": true
    },
    "usage_updated_payload": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "turn_succeeded_payload": {
      "type": "object",
      "properties": { "result": true },
      "additionalProperties": true
    },
    "agent_error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "invalid_input",
            "agent_runtime_unavailable",
            "agent_schema_mismatch",
            "session_not_found",
            "session_busy",
            "turn_not_found",
            "turn_terminal",
            "duplicate_request",
            "model_not_configured",
            "model_unavailable",
            "context_budget_exceeded",
            "approval_required",
            "approval_expired",
            "tool_failed",
            "cancelled",
            "interrupted",
            "invalid_session_token",
            "sdk_internal_error"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      },
      "additionalProperties": true
    },
    "turn_failed_payload": {
      "type": "object",
      "properties": { "error": { "$ref": "#/$defs/agent_error" } },
      "additionalProperties": true
    },
    "turn_cancelled_payload": {
      "type": "object",
      "properties": { "reason": { "type": "string" } },
      "additionalProperties": true
    },
    "turn_interrupted_payload": {
      "type": "object",
      "properties": { "reason": { "type": "string" } },
      "additionalProperties": true
    }
  }
}
