{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notemeld.wiki/schemas/turn-request.v1.json",
  "title": "TurnRequest v1",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "session_id",
    "input",
    "model_override",
    "approval_mode"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "request_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "input": {
      "type": "object",
      "required": ["text", "attachments", "context_refs"],
      "properties": {
        "text": { "type": "string" },
        "attachments": { "type": "array", "items": {} },
        "context_refs": { "type": "array", "items": {} }
      },
      "additionalProperties": true
    },
    "model_override": { "type": ["object", "null"] },
    "approval_mode": {
      "enum": ["interactive", "deny", "allow_safe"]
    }
  },
  "additionalProperties": true
}
