# Required on first startup; never commit real credentials.
NOTEMELD_CLOUD_ADMIN_USERNAME=admin
NOTEMELD_CLOUD_ADMIN_PASSWORD=change-me-please-123

# Optional deployment settings.
NOTEMELD_CLOUD_DATA_DIR=/var/lib/notemeld-cloud
NOTEMELD_CLOUD_MAX_WORKSPACE_BYTES=1000000000
NOTEMELD_CLOUD_MAX_WORKSPACE_FILES=10000
NOTEMELD_CLOUD_MAX_REQUEST_BYTES=16777216
# Comma-separated explicit browser origins; leave empty to disable CORS.
NOTEMELD_CLOUD_CORS_ORIGINS=

# Optional OpenAI-compatible Cloud Agent provider.
NOTEMELD_CLOUD_AGENT_BASE_URL=
NOTEMELD_CLOUD_AGENT_MODEL=cloud-agent
NOTEMELD_CLOUD_AGENT_API_KEY=
NOTEMELD_CLOUD_AGENT_TIMEOUT_SECONDS=120
# Recommended for production: require Ed25519 device proof before relay connect.
NOTEMELD_CLOUD_REQUIRE_DEVICE_PROOF=0
NOTEMELD_CLOUD_COMMAND_WAIT_SECONDS=20
NOTEMELD_CLOUD_COMMAND_LEASE_SECONDS=300
# Optional stable secret used to encrypt provider API keys at rest. If omitted,
# the bootstrap admin password is used as the derivation secret.
NOTEMELD_CLOUD_SECRET_KEY=
