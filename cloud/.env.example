# Required on first startup; never commit real credentials.
NOTEMELD_CLOUD_ENV=development
NOTEMELD_CLOUD_ADMIN_USERNAME=admin
NOTEMELD_CLOUD_ADMIN_PASSWORD=change-me-please-123
NOTEMELD_CLOUD_ADMIN_EMAIL=admin@example.com

# Local development returns this code in the API response. Production must
# disable dev mode and configure SMTP; the code is then delivered by email.
NOTEMELD_CLOUD_OTP_DEV_MODE=1
NOTEMELD_CLOUD_DEV_OTP_CODE=888888
NOTEMELD_CLOUD_STARTUP_BACKUP_IMAGE=
NOTEMELD_CLOUD_STARTUP_BACKUP_WORKSPACE=default
NOTEMELD_CLOUD_SMTP_HOST=
NOTEMELD_CLOUD_SMTP_PORT=587
NOTEMELD_CLOUD_SMTP_USERNAME=
NOTEMELD_CLOUD_SMTP_PASSWORD=
NOTEMELD_CLOUD_SMTP_SENDER=

# Backups: local filesystem for development, S3-compatible object storage in production.
NOTEMELD_CLOUD_BACKUP_STORAGE=local
NOTEMELD_CLOUD_S3_ENDPOINT_URL=
NOTEMELD_CLOUD_S3_BUCKET=
NOTEMELD_CLOUD_S3_REGION=
NOTEMELD_CLOUD_S3_ACCESS_KEY_ID=
NOTEMELD_CLOUD_S3_SECRET_ACCESS_KEY=
NOTEMELD_CLOUD_S3_PREFIX=notemeld-backups

# Optional deployment settings.
NOTEMELD_CLOUD_DATA_DIR=/var/lib/notemeld-cloud
NOTEMELD_CLOUD_MAX_WORKSPACE_BYTES=1000000000
NOTEMELD_CLOUD_MAX_WORKSPACE_FILES=10000
NOTEMELD_CLOUD_WORKSPACE_WARNING_PERCENT=80
NOTEMELD_CLOUD_MAX_WORKSPACE_READ_BYTES=1000000
NOTEMELD_CLOUD_MAX_WORKSPACE_LIST_ITEMS=5000
NOTEMELD_CLOUD_MAX_BACKUP_LIST_ITEMS=1000
NOTEMELD_CLOUD_MAX_REQUEST_BYTES=16777216
NOTEMELD_CLOUD_APPROVAL_TTL_SECONDS=900
# Comma-separated explicit browser origins; leave empty to disable CORS.
NOTEMELD_CLOUD_CORS_ORIGINS=

# Optional OpenAI-compatible Cloud Agent provider.
NOTEMELD_CLOUD_AGENT_BASE_URL=
NOTEMELD_CLOUD_AGENT_MODEL=cloud-agent
NOTEMELD_CLOUD_AGENT_API_KEY=
NOTEMELD_CLOUD_AGENT_TIMEOUT_SECONDS=120
NOTEMELD_CLOUD_AGENT_MAX_RETRIES=2
NOTEMELD_CLOUD_RELAY_MAX_FRAME_BYTES=262144
NOTEMELD_CLOUD_MAX_ACTIVE_COMMANDS_PER_USER=8
# Recommended for production: require Ed25519 device proof before relay connect.
NOTEMELD_CLOUD_REQUIRE_DEVICE_PROOF=0
NOTEMELD_CLOUD_DEVICE_ONLINE_TTL_SECONDS=90
NOTEMELD_CLOUD_COMMAND_WAIT_SECONDS=20
NOTEMELD_CLOUD_COMMAND_LEASE_SECONDS=300
# Relay backend is memory for one worker; use a compatible Pub/Sub backend
# before setting WEB_CONCURRENCY above 1.
NOTEMELD_CLOUD_RELAY_BACKEND=memory
# Required when NOTEMELD_CLOUD_RELAY_BACKEND=redis; use rediss:// in production.
NOTEMELD_CLOUD_RELAY_URL=
WEB_CONCURRENCY=1
# Required before storing provider API keys. Keep stable across restarts and
# backups; administrator passwords are never used as an encryption key.
NOTEMELD_CLOUD_SECRET_KEY=
