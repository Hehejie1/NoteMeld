#!/usr/bin/env bash
set -euo pipefail

NOTEMELD_HOME="${NOTEMELD_HOME:-$HOME/.notemeld}"
APP_DIR="${NOTEMELD_APP_DIR:-$NOTEMELD_HOME/app}"
DATA_ROOT="${APP_DIR}/vector_db"
LOG_DIR="${APP_DIR}/logs"
MODEL_DIR="${DATA_ROOT}/models"
RUN_DIR="${DATA_ROOT}/run"
NOTEMELD_RUNTIME_MODE="${NOTEMELD_RUNTIME_MODE:-source-cli}"
EXPECTED_NOTEMELD_AGENT_SDK_VERSION="0.1.0"
EXPECTED_NOTEMELD_AGENT_SCHEMA_VERSION="1"
EXPECTED_NOTEMELD_AGENT_ABI_VERSION="2"

BACKEND_PORT="${NOTEMELD_BACKEND_PORT:-8483}"
FRONTEND_PORT="${NOTEMELD_FRONTEND_PORT:-3015}"

BACKEND_LOG="${LOG_DIR}/backend.log"
FRONTEND_LOG="${LOG_DIR}/frontend.log"
BACKEND_PID_FILE="${RUN_DIR}/backend.pid"
FRONTEND_PID_FILE="${RUN_DIR}/frontend.pid"

log() {
  printf '[NoteMeld] %s\n' "$*"
}

warn() {
  printf '[NoteMeld] WARN: %s\n' "$*" >&2
}

fail() {
  printf '[NoteMeld] ERROR: %s\n' "$*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "Missing required command: $1"
}

port_in_use() {
  lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

wait_for_url() {
  local url="$1"
  local retries="${2:-60}"
  local sleep_seconds="${3:-2}"

  for ((i = 1; i <= retries; i++)); do
    if curl -fsS "$url" >/dev/null 2>&1; then
      return 0
    fi
    sleep "$sleep_seconds"
  done

  return 1
}

open_browser() {
  local url="$1"

  if command -v open >/dev/null 2>&1; then
    open "$url" >/dev/null 2>&1 || true
    return 0
  fi

  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 || true
  fi
}

prepare_dirs() {
  mkdir -p \
    "$LOG_DIR" \
    "$RUN_DIR" \
    "$DATA_ROOT/note_results" \
    "$DATA_ROOT/chroma" \
    "$DATA_ROOT/config" \
    "$DATA_ROOT/uploads" \
    "$DATA_ROOT/static/screenshots" \
    "$DATA_ROOT/tmp" \
    "$DATA_ROOT/data/output_frames" \
    "$MODEL_DIR"
}

export_runtime_env() {
  export NOTEMELD_RUNTIME_MODE
  export NOTEMELD_DATA_DIR="$DATA_ROOT"
  export NOTEMELD_LOG_DIR="$LOG_DIR"
}

ensure_agent_sdk() {
  local python_bin="$APP_DIR/.venv/bin/python"
  local check_code='import notemeld_agent_sdk.runtime as sdk_runtime
if str(getattr(sdk_runtime, "SDK_VERSION", "")) == "0.1.0" and \
   str(getattr(sdk_runtime, "SCHEMA_VERSION", "")) == "1" and \
   str(getattr(sdk_runtime, "ABI_VERSION", "")) == "2":
    raise SystemExit(0)
raise SystemExit(1)
'
  if "$python_bin" -c "$check_code" >/dev/null 2>&1; then
    return 0
  fi

  local wheel="${NOTEMELD_AGENT_SDK_WHEEL:-}"
  if [[ -z "$wheel" ]]; then
    fail "notemeld-agent-sdk is not installed. Set NOTEMELD_AGENT_SDK_WHEEL to the compiled wheel."
  fi
  [[ -f "$wheel" ]] || fail "Agent SDK wheel not found: ${wheel}"
  log "Installing standalone Agent SDK wheel"
  "$python_bin" -m pip install --disable-pip-version-check --no-deps --force-reinstall "$wheel"
  "$python_bin" -c "$check_code" >/dev/null 2>&1 \
    || fail "Installed notemeld-agent-sdk is incompatible (expected SDK_VERSION=${EXPECTED_NOTEMELD_AGENT_SDK_VERSION} SCHEMA_VERSION=${EXPECTED_NOTEMELD_AGENT_SCHEMA_VERSION} ABI_VERSION=${EXPECTED_NOTEMELD_AGENT_ABI_VERSION})"
}

ensure_installed() {
  [[ -d "$APP_DIR" ]] || fail "NoteMeld app not found at ${APP_DIR}. Run the installer first."
  [[ -d "$APP_DIR/backend" ]] || fail "Backend directory not found at ${APP_DIR}/backend."
  [[ -d "$APP_DIR/frontend" ]] || fail "Frontend directory not found at ${APP_DIR}/frontend."
  [[ -x "$APP_DIR/.venv/bin/python" ]] || fail "Python virtualenv not found. Run: notemeld doctor"
}

is_pid_running() {
  local file="$1"

  [[ -f "$file" ]] || return 1

  local pid
  pid="$(cat "$file" 2>/dev/null || true)"
  [[ -n "$pid" ]] || return 1

  kill -0 "$pid" >/dev/null 2>&1
}

start_backend() {
  if is_pid_running "$BACKEND_PID_FILE"; then
    log "Backend is already running with PID $(cat "$BACKEND_PID_FILE")"
    return 0
  fi

  if port_in_use "$BACKEND_PORT"; then
    warn "Backend port ${BACKEND_PORT} is already in use. Skipping backend start."
    return 0
  fi

  log "Starting backend on http://127.0.0.1:${BACKEND_PORT}"

  (
    cd "$APP_DIR/backend"
    export_runtime_env
    "$APP_DIR/.venv/bin/python" main.py
  ) > "$BACKEND_LOG" 2>&1 &

  echo $! > "$BACKEND_PID_FILE"

  if ! wait_for_url "http://127.0.0.1:${BACKEND_PORT}/api/sys_check" 90 2; then
    tail -n 80 "$BACKEND_LOG" >&2 || true
    fail "Backend failed to start. See ${BACKEND_LOG}"
  fi
}

start_frontend() {
  if is_pid_running "$FRONTEND_PID_FILE"; then
    log "Frontend is already running with PID $(cat "$FRONTEND_PID_FILE")"
    return 0
  fi

  if port_in_use "$FRONTEND_PORT"; then
    warn "Frontend port ${FRONTEND_PORT} is already in use. Skipping frontend start."
    return 0
  fi

  log "Starting frontend on http://127.0.0.1:${FRONTEND_PORT}"

  (
    cd "$APP_DIR/frontend"
    VITE_API_BASE_URL="http://127.0.0.1:${BACKEND_PORT}/api" \
    VITE_SCREENSHOT_BASE_URL="http://127.0.0.1:${BACKEND_PORT}/static/screenshots" \
    corepack pnpm dev --host 127.0.0.1 --port "$FRONTEND_PORT"
  ) > "$FRONTEND_LOG" 2>&1 &

  echo $! > "$FRONTEND_PID_FILE"

  if ! wait_for_url "http://127.0.0.1:${FRONTEND_PORT}" 90 2; then
    tail -n 80 "$FRONTEND_LOG" >&2 || true
    fail "Frontend failed to start. See ${FRONTEND_LOG}"
  fi
}

stop_pid_file() {
  local file="$1"
  local label="$2"

  if [[ ! -f "$file" ]]; then
    return 0
  fi

  local pid
  pid="$(cat "$file" 2>/dev/null || true)"

  if [[ -n "$pid" ]] && kill -0 "$pid" >/dev/null 2>&1; then
    kill "$pid" >/dev/null 2>&1 || true
    log "Stopped ${label} process ${pid}"
  fi

  rm -f "$file"
}

cmd_start() {
  ensure_installed
  require_cmd curl
  require_cmd lsof
  require_cmd corepack

  prepare_dirs
  export_runtime_env
  ensure_agent_sdk

  start_backend
  start_frontend

  log "NoteMeld is running"
  log "Frontend: http://127.0.0.1:${FRONTEND_PORT}"
  log "Backend:  http://127.0.0.1:${BACKEND_PORT}"
  log "Logs:     ${LOG_DIR}"

  open_browser "http://127.0.0.1:${FRONTEND_PORT}"
}

cmd_stop() {
  stop_pid_file "$FRONTEND_PID_FILE" "frontend"
  stop_pid_file "$BACKEND_PID_FILE" "backend"
}

cmd_restart() {
  cmd_stop
  cmd_start
}

cmd_logs() {
  mkdir -p "$LOG_DIR"
  touch "$BACKEND_LOG" "$FRONTEND_LOG"
  tail -f "$BACKEND_LOG" "$FRONTEND_LOG"
}

cmd_doctor() {
  log "Checking NoteMeld environment"

  require_cmd git
  require_cmd curl
  require_cmd python3.11
  require_cmd node
  require_cmd corepack
  require_cmd ffmpeg
  require_cmd lsof

  [[ -d "$APP_DIR" ]] || fail "Missing app directory: ${APP_DIR}"
  [[ -d "$APP_DIR/.git" ]] || warn "${APP_DIR} is not a git repository"
  [[ -x "$APP_DIR/.venv/bin/python" ]] || fail "Missing Python virtualenv: ${APP_DIR}/.venv"
  [[ -d "$APP_DIR/frontend/node_modules" ]] || fail "Missing frontend dependencies: ${APP_DIR}/frontend/node_modules"

  log "Doctor passed"
}

cmd_update() {
  ensure_installed
  [[ -d "$APP_DIR/.git" ]] || fail "Cannot update because ${APP_DIR} is not a git repository."

  log "Updating NoteMeld"

  cd "$APP_DIR"
  git pull --ff-only

  "$APP_DIR/.venv/bin/python" -m pip install -r backend/requirements.txt

  cd "$APP_DIR/frontend"
  corepack pnpm install --registry https://registry.npmjs.org

  log "Update complete"
}

cmd_uninstall() {
  cmd_stop || true

  rm -f "$HOME/.local/bin/notemeld"

  log "Removed CLI: ${HOME}/.local/bin/notemeld"
  log "User data is kept at: ${NOTEMELD_HOME}"
  log "To remove everything manually, run: rm -rf ${NOTEMELD_HOME}"
}

cmd_agent() {
  ensure_installed
  require_cmd curl
  prepare_dirs
  export_runtime_env
  ensure_agent_sdk
  start_backend
  exec "$APP_DIR/.venv/bin/python" "$APP_DIR/scripts/notemeld-agent.py" "$@"
}

cmd_help() {
  cat <<EOF
NoteMeld CLI

Usage:
  notemeld              Start NoteMeld
  notemeld start        Start NoteMeld
  notemeld stop         Stop NoteMeld
  notemeld restart      Restart NoteMeld
  notemeld logs         Follow backend and frontend logs
  notemeld agent        Open the shared Agent CLI session
  notemeld doctor       Check local dependencies and installation
  notemeld update       Pull latest code and refresh dependencies
  notemeld uninstall    Remove CLI only, keep user data
  notemeld help         Show this help

Environment:
  NOTEMELD_HOME         Default: ~/.notemeld
  NOTEMELD_BACKEND_PORT Default: 8483
  NOTEMELD_FRONTEND_PORT Default: 3015
  NOTEMELD_AGENT_SDK_WHEEL  Compiled standalone SDK wheel to install
EOF
}

main() {
  local cmd="${1:-start}"

  case "$cmd" in
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    logs) cmd_logs ;;
    agent) shift; cmd_agent "$@" ;;
    doctor) cmd_doctor ;;
    update) cmd_update ;;
    uninstall) cmd_uninstall ;;
    help|--help|-h) cmd_help ;;
    *) fail "Unknown command: ${cmd}" ;;
  esac
}

main "$@"
